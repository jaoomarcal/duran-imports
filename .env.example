# Copie para ".env" e preencha com os dados do seu projeto Supabase.

# Supabase -> Project Settings -> Data API -> "Project URL"
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# (o formato antigo "anon key" / eyJhbGciOi... também funciona)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
